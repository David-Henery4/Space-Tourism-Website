---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
export const getStaticPaths = (async () => {
  const technology = await getCollection("technologyCollection");
  return technology.map((technologyData) => {
    return {
      params: {
        slug: technologyData.data.slug,
      },
      props: { technologyData },
    };
  });
}) satisfies GetStaticPaths;
const {
  technologyData: { data },
} = Astro.props;
//
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BackgroundImages, PageSubHeading } from "../../components";
import technologyBgImageMobile from "../../assets/bg-images/technology/background-technology-mobile.jpg";
import technologyBgImageTablet from "../../assets/bg-images/technology/background-technology-tablet.jpg";
import technologyBgImageDesktop from "../../assets/bg-images/technology/background-technology-desktop.jpg";
import {
  TechImage,
  TechTextContent,
  ToggleButtons,
} from "@components/technology";
---

<BaseLayout>
  <BackgroundImages
    mobileImage={technologyBgImageMobile}
    tabletImage={technologyBgImageTablet}
    desktopImage={technologyBgImageDesktop}
  />

  <main
    class="w-full max-w-360 mx-auto pt-6 pb-20 col-start-1 col-end-13 text-center grid gap-y-8.5 grid-cols-main-mobile mobile:pt-10 mobile:pb-24 mobile:gap-y-14 mobile:grid-cols-main-tablet tablet:grid-cols-main-laptop laptop:pt-19 laptop:pb-24 desktop:grid-cols-main-desktop desktop:gap-y-6.5"
  >
    <div class="col-start-2 col-end-12 mobile:text-left mobile:mb-5 laptop:m-0">
      <PageSubHeading pageNumber="03" title="SPACE LAUNCH 101" />
    </div>

    <TechImage image={data.image} />

    <section
      class="col-start-2 col-end-12 flex flex-col gap-6.5 mobile:gap-11 laptop:col-end-8 laptop:row-start-2 laptop:row-end-3 laptop:text-left desktop:flex-row desktop:items-center desktop:gap-15 desktop-xl-large:gap-20"
    >
      <ToggleButtons slug={data.slug} />
      <TechTextContent title={data.name} description={data.description} />
    </section>
  </main>
</BaseLayout>
