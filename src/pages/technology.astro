---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BackgroundImages, PageSubHeading } from "../components";
import crewBgImageMobile from "../assets/bg-images/technology/background-technology-mobile.jpg";
import technologyBgImageTablet from "../assets/bg-images/technology/background-technology-tablet.jpg";
import technologyBgImageDesktop from "../assets/bg-images/technology/background-technology-desktop.jpg";
import {
  TechImage,
  TechTextContent,
  ToggleButtons,
} from "@components/technology";
---

<BaseLayout>
  <BackgroundImages
    mobileImage={crewBgImageMobile}
    tabletImage={technologyBgImageTablet}
    desktopImage={technologyBgImageDesktop}
  />
  <!-- HAS A BLEED SECTION, REFACTOR! (IMAGE) -->
  <main
    class="pt-6 pb-20 col-start-1 col-end-13 text-center grid gap-y-8.5 grid-cols-main-mobile mobile:pt-10 mobile:pb-24 mobile:gap-y-14 mobile:grid-cols-main-tablet tablet:grid-cols-main-laptop desktop:grid-cols-main-desktop"
  >
    <div class="col-start-2 col-end-12 mobile:text-left mobile:mb-5 laptop:m-0">
      <PageSubHeading pageNumber="03" title="SPACE LAUNCH 101" />
    </div>

    <!-- HAS A BLEED SECTION, REFACTOR! (IMAGE) -->
    <TechImage />

    <section class="col-start-2 col-end-12 flex flex-col gap-6.5 mobile:gap-11">
      <ToggleButtons />
      <TechTextContent />
    </section>
  </main>
</BaseLayout>
