---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Header } from "../components";
import homeBgImageMobile from "../assets/bg-images/home/background-home-mobile.jpg";
import homeBgImageTablet from "../assets/bg-images/home/background-home-tablet.jpg";
import homeBgImageDesktop from "../assets/bg-images/home/background-home-desktop.jpg";
import { BackgroundImages } from "../components";
---

<BaseLayout
  SEOInfo={{
    pageTitle: "Space Tourism — Explore the Cosmos",
    description:
      "Official Space Tourism — destinations, crew, and technology to plan your next interstellar journey.",
    canonicalURL: "https://space-tourism.example/",
    ogImage: "https://space-tourism.example/assets/meta-image/meta-image.png",
    ogDescription:
      "Official Space Tourism — destinations, crew, and technology to plan your next interstellar journey.",
    ogTitle: "Space Tourism — Explore the Cosmos",
    image: "https://space-tourism.example/assets/meta-image/meta-image.png",
  }}
>
  <BackgroundImages
    desktopImage={homeBgImageDesktop}
    mobileImage={homeBgImageMobile}
    tabletImage={homeBgImageTablet}
  />
  <Header />
</BaseLayout>
