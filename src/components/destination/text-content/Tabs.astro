---
import { getCollection } from "astro:content";
const destinations = await getCollection("destinationCollection");
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<script src="../../../scripts/updateSlide.ts"></script>

<menu
  id="destination-tabs"
  class="flex justify-center items-center gap-6 sub-heading-2 laptop:col-start-2 laptop:col-end-7 laptop:justify-start"
>
  {
    destinations
      .sort((a, b) => a.data.id - b.data.id)
      .map((destination) => {
        const isActive = destination.data.slug === slug;
        return (
          <li class="relative pb-2 mobile:pb-3">
            <a
              href={`/destination/${destination.data.slug}`}
              class="uppercase hover:cursor-pointer"
            >
              {destination.data.name}
            </a>

            <div
              data-slug={`${destination.data.slug}`}
              class={`${isActive ? "block" : "hidden"} absolute bottom-0 w-full h-0.75 bg-white`}
            />
          </li>
        );
      })
  }
</menu>
