---
import { Image } from "astro:assets";
import { PageSubHeading } from "../"; // Might have to change path
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  slug: string;
}
const { image, slug } = Astro.props;
---

<div
  class="w-full grid gap-8 mobile:gap-15 laptop:grid-rows-main-laptop laptop:gap-24.25"
>
  <PageSubHeading title="Pick your destination" pageNumber="01" />

  <div id="destination-image-container" data-slug={slug} class="max-w-42.5 mx-auto mobile:max-w-75 laptop:max-w-111.25">
    <!-- <Image id="destination-image" src={image} alt="" /> -->
  </div>
</div>
