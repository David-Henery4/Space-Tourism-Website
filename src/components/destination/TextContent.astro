---
import { Tabs } from "./text-content";
interface Props {
  id: number;
  name: string;
  description: string;
  slug: string;
  distance: string;
  travelTime: string;
  image: {
    src: string;
    width: number;
    height: number;
    format: "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif";
  };
}
const { description, distance, name, travelTime, slug } = Astro.props;
---

<div
  class="w-full laptop:grid laptop:grid-cols-basic-6-cols laptop:text-left laptop:pt-21.25"
>
  <Tabs slug={slug} />

  <div
    id="destination-title-description"
    class="mt-5 mb-8 mobile:mt-8 mobile:mb-12 laptop:col-start-2 laptop:col-end-7 laptop:mt-9.25 laptop:mb-13.5"
  >
    <h1 class="uppercase text-[56px] mobile:text-[80px] laptop:text-[100px]">
      {name}
    </h1>
    <p
      class="base-text mx-auto max-w-81.75 mobile:max-w-143.25 laptop:max-w-111 laptop:mt-3.5 laptop:ml-0"
    >
      {description}
    </p>
  </div>

  <div
    id="destination-details"
    class="uppercase py-8 flex flex-col justify-center items-center gap-8 border-t border-t-white-faded mobile:flex-row mobile:gap-12 mobile:py-7 laptop:col-start-2 laptop:col-end-7 laptop:justify-start"
  >
    <div class="">
      <h3 class="sub-heading-2">AVG. DISTANCE</h3>
      <p class="mt-3 sub-heading-1">{distance}</p>
    </div>

    <div class="">
      <h3 class="sub-heading-2">Est. travel time</h3>
      <p class="mt-3 sub-heading-1">{travelTime}</p>
    </div>
  </div>
</div>
