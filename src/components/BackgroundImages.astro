---
import { Image } from "astro:assets";
import { type ImageMetadata } from "astro";
interface Props {
  mobileImage: ImageMetadata;
  tabletImage: ImageMetadata;
  desktopImage: ImageMetadata;
}
const { desktopImage, mobileImage, tabletImage } = Astro.props;
---

<Image
  class="absolute -z-1 inset-0 w-screen h-screen object-center object-cover mobile:hidden"
  src={mobileImage}
  alt=""
/>
<Image
  class="absolute -z-1 top-0 left-0 w-full h-full object-center object-cover hidden mobile:block"
  src={tabletImage}
  alt=""
/>
<Image
  class="absolute -z-1 top-0 left-0 w-full h-full object-center object-cover hidden"
  src={tabletImage}
  alt=""
/>
