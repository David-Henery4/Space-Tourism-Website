---
interface Props {
  pageNumber: string;
  title: string;
}
const { pageNumber, title } = Astro.props;
---

<h2
  class="text-base tracking-[2.7px] font-barlow-condensed uppercase inline-flex gap-4.5 justify-center mobile:justify-start mobile:text-xl mobile:tracking-[3.38px] tablet:text-[28px] tablet:tracking-[4.72px]"
>
  <span class="text-white/25">{pageNumber}</span>
  {title}
</h2>
