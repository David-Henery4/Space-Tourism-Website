---
import { Image } from "astro:assets";
// import crewImage1 from "../../assets/content-images/crew/image-douglas-hurley.webp";
import { type ImageMetadata } from "astro";
interface Props {
  image: ImageMetadata;
}
const { image } = Astro.props;
---

<div
  class="w-full border-b border-white/15 mobile:row-start-4 mobile:row-end-5 mobile:border-0 laptop:self-end laptop:row-start-1 laptop:row-end-4 laptop:col-start-2 laptop:col-end-3"
>
  <Image
    id="crew-image"
    src={image}
    alt=""
    class="w-full h-55.75 max-w-48.25 mx-auto object-center object-fill mobile:h-133.75 mobile:max-w-108.25 mobile:mx-auto laptop:mr-0 mobile-large:max-w-102.25 desktop:max-w-126.5"
  />
</div>
