---
import "../styles/global.css";
import { Font } from "astro:assets";
interface Props {
  SEOInfo: {
    // Core SEO
    pageTitle: string;
    description: string;

    // Canonical URL
    canonicalURL: string;

    // Social Media & Sharing
    ogImage: string;
    ogTitle?: string;
    ogDescription?: string;

    // Additional SEO Signals
    keywords?: string;
    author?: string;

    // Indexing Control
    robots?: string;

    // Social Specific
    twitterHandle?: string;

    // Optional but Useful
    image?: string;
  };
}
const {
  SEOInfo: {
    canonicalURL,
    description,
    ogImage,
    pageTitle,
    ogTitle,
    ogDescription,
    image,
  },
} = Astro.props;
import { Navigation } from "../components";
import SEOHeads from "../components/seo/SEOHeads.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEOHeads
      canonicalURL={canonicalURL}
      description={description}
      ogImage={ogImage}
      pageTitle={pageTitle}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      image={image}
    />
    <Font cssVariable="--bellefair" />
    <Font cssVariable="--barlow-condensed" />
    <Font cssVariable="--barlow" />
    <title>{pageTitle}</title>
  </head>
  <body
    class="bg-primary scroll-smooth relative text-white font-bellefair grid grid-cols-main-mobile mobile:grid-cols-main-tablet tablet:grid-cols-main-laptop laptop:min-h-svh laptop:grid-rows-main-laptop desktop:grid-cols-main-desktop"
  >
    <Navigation />
    <slot />
  </body>
</html>
